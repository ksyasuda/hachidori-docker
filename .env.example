# Copy to .env and adjust. Run `docker compose up -d` after changing it.
# The container uses host networking: it listens directly on this machine's
# interfaces, and reaches AnkiConnect at its default http://127.0.0.1:8765.

# --- Ports ---
# Management page and API.
ADMIN_PORT=8780
# Sharing WebSocket relay that Hachidori browsers and SubMiner link to.
RELAY_PORT=8771
# Yomitan-compatible HTTP API.
API_PORT=19633
# The Hachidori Relay Anki add-on also uses 8771 and 19633. Remove it from Anki,
# or move RELAY_PORT and API_PORT to free ports.

# --- Network exposure ---
# true: relay and Yomitan API listen on every interface, so other computers can
# link over the LAN or Tailscale. false: this machine only.
# Management, the relay and the API have no authentication or TLS. Use only on
# a trusted LAN or tailnet; never expose them to the Internet.
RELAY_NETWORK=true

# Where the management listener binds. 0.0.0.0 listens on every interface
# (LAN, Tailscale); set 127.0.0.1 to keep it on this machine.
ADMIN_BIND_ADDRESS=0.0.0.0
# Comma-separated extra hostnames the management API accepts, such as a reverse
# proxy domain. localhost, IP addresses, the machine's hostname and its Tailscale
# MagicDNS name are already accepted.
ADMIN_HOSTS=

# --- Folder imports ---
# Host folder mounted read-only at /imports and scanned once at startup.
IMPORTS_PATH=./imports
# Path scanned inside the container. Set to empty (IMPORT_DIR=) to disable scanning.
IMPORT_DIR=/imports
